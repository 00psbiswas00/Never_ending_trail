---
import '../styles/global.css';
import '../styles/motion.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const here = (p: string) => (path === p || path.startsWith(p + '/') ? 'page' : undefined);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title} — Never Ending Trail Club</title>
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/assets/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/assets/apple-touch-icon-180.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400;62..125,600;62..125,800&family=IBM+Plex+Mono:wght@600&family=Anek+Bangla:wght@500;700&display=swap" rel="stylesheet" />
    <script is:inline src="/netc-loader.js"></script>
  </head>
  <body>
    <header class="site">
      <div class="wrap">
        <a class="lockup" href="/">
          <img src="/assets/netc-primary-horizontal-colour.svg" alt="Never Ending Trail Club" />
        </a>
        <nav class="main" aria-label="Main">
          <a class="nl" href="/#trips">Trips</a>
          <a class="nl" href="/stories" aria-current={here('/stories') ?? here('/story')}>Stories</a>
          <a class="nl" href="/about" aria-current={here('/about')}>About us</a>
        </nav>
        <a class="btn" href="/join" aria-current={here('/join')}>Join a trip</a>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site on-indigo">
      <div class="wrap">
        <div class="top">
          <div>
            <img
              class="flogo"
              src="/assets/netc-alternate-bilingual-reverse.svg"
              alt="Never Ending Trail Club · নেভার এন্ডিং ট্রেল ক্লাব"
            />
          </div>
          <div>
            <div class="label h">Club</div>
            <ul>
              <li><a href="/#trips">Trips</a></li>
              <li><a href="/stories">Stories</a></li>
              <li><a href="/about">About us</a></li>
              <li><a href="/join">Join a trip</a></li>
            </ul>
          </div>
          <div>
            <div class="label h">Follow</div>
            <ul>
              <li><a href="#">Instagram</a></li>
              <li><a href="#">YouTube</a></li>
              <li><a href="#">Facebook</a></li>
            </ul>
          </div>
        </div>
        <div class="bot">
          <span>Travel · Stories · Friends</span>
          <span class="label">Trip 12 and counting</span>
        </div>
      </div>
    </footer>
    <script is:inline src="/netc-motion.js"></script>

    <!-- NETC sun cursor trail -->
    <svg class="netc-trail" aria-hidden="true"><circle r="2.5"/><circle r="2.5"/></svg>

    <style>
      .netc-trail { position: fixed; inset: 0; width: 100%; height: 100%;
        pointer-events: none; z-index: 9998; overflow: visible; }
      .netc-trail path { fill: none; stroke: #C9372C;
        stroke-linecap: round; stroke-linejoin: round; opacity: 0; transition: opacity .25s; }
      .netc-trail circle { fill: #C9372C; opacity: 0; transition: opacity .25s; }
      body.netc-moving .netc-trail path { opacity: .35; }
      body.netc-moving .netc-trail circle { opacity: .6; }
    </style>

    <script is:inline>
      (() => {
        if (!matchMedia('(pointer: fine)').matches) return;
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        const svg = document.querySelector('.netc-trail');
        const dots = svg.querySelectorAll('circle');
        const segs = Array.from({ length: 8 }, () => svg.insertBefore(
          document.createElementNS('http://www.w3.org/2000/svg', 'path'), svg.firstChild));
        const hist = [];
        let tx = null, ty = null, fx = 0, fy = 0, idle;
        addEventListener('pointermove', e => {
          if (tx === null) { fx = e.clientX; fy = e.clientY; }
          tx = e.clientX; ty = e.clientY;
          document.body.classList.add('netc-moving');
          clearTimeout(idle);
          idle = setTimeout(() => document.body.classList.remove('netc-moving'), 450);
        });
        (function tick() {
          if (tx !== null) {
            fx += (tx - fx) * 0.3; fy += (ty - fy) * 0.3;
            hist.unshift({ x: fx, y: fy }); if (hist.length > 15) hist.pop();
            [2, 4].forEach((k, i) => { const p = hist[Math.min(k, hist.length - 1)];
              dots[i].setAttribute('cx', p.x); dots[i].setAttribute('cy', p.y); });
            segs.forEach((el, i) => {
              const a = hist[6 + i], b = hist[7 + i];
              el.setAttribute('d', a && b ? `M${a.x} ${a.y}L${b.x} ${b.y}` : '');
              el.style.strokeWidth = 2.6 - i * 0.3;
            });
          }
          requestAnimationFrame(tick);
        })();
      })();

    </script>
  </body>
</html>

<style>
  ::-webkit-scrollbar {
    width: 12px;
    height: 12px;
  }

  ::-webkit-scrollbar-track {
    background: var(--paper);
  }

  ::-webkit-scrollbar-thumb {
    background: var(--red);
    border: 3px solid var(--paper);
  }

  ::-webkit-scrollbar-thumb:hover {
    background: var(--indigo);
  }

  /* NETC sun cursor; hand on anything clickable; light variants on indigo */
  :global(body) {
    cursor: url('/cursors/netc-sun.svg') 16 16, auto;
  }

  :global(a), :global(button), :global([role="button"]), :global(label), :global(summary),
  :global(.tcard), :global(.chan), :global(.card), :global(.btn), :global(.ncard) {
    cursor: url('/cursors/netc-hand.svg') 13 3, pointer !important;
  }

  :global(input), :global(textarea), :global([contenteditable]) {
    cursor: text !important;
  }

  :global(.on-indigo) {
    cursor: url('/cursors/netc-sun-dark.svg') 16 16, auto;
  }

  :global(.on-indigo a), :global(.on-indigo button), :global(.on-indigo [role="button"]), :global(.on-indigo label),
  :global(.on-indigo .tcard), :global(.on-indigo .chan), :global(.on-indigo .card), :global(.on-indigo .btn), :global(.on-indigo .ncard) {
    cursor: url('/cursors/netc-hand-dark.svg') 13 3, pointer !important;
  }

  @media (prefers-contrast: more) {
    :global(a) {
      text-decoration-thickness: 2px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(*) {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }

  header.site {
    position: sticky;
    top: 0;
    z-index: 100;
  }

  header.site .wrap {
    gap: 32px;
  }

  nav.main {
    margin-left: auto;
  }

  @media (max-width: 768px) {
    /* Phone: logo + Join on top, the three sections as a thumb-height strip below */
    header.site .wrap {
      height: auto;
      flex-wrap: wrap;
      row-gap: 8px;
      padding-top: 8px;
    }

    .lockup img {
      height: 40px;
    }

    header.site .btn {
      margin-left: auto;
    }

    nav.main {
      order: 3;
      flex: 1 0 100%;
      margin: 0 -20px;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0;
      border-top: 2px solid var(--indigo);
    }

    nav.main a.nl {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 44px;
      padding: 0 4px;
      border-bottom: 0;
      font: 600 13px/1 var(--mono);
      letter-spacing: 2px;
      text-transform: uppercase;
      white-space: nowrap;
    }

    nav.main a.nl + a.nl {
      border-left: 2px solid var(--indigo);
    }

    nav.main a.nl[aria-current] {
      box-shadow: inset 0 -4px 0 var(--turmeric);
    }

    footer.site .top {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
