---
import '../styles/global.css';
import '../styles/motion.css';
import '../styles/netc.css';
import '../styles/netc-motion.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title} — Never Ending Trail Club</title>
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/assets/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/assets/apple-touch-icon-180.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400;62..125,600;62..125,800&family=IBM+Plex+Mono:wght@600&family=Anek+Bangla:wght@500;700&display=swap" rel="stylesheet" />
    <script is:inline src="/netc-loader.js"></script>
    <script is:inline src="/image-slot.js"></script>
  </head>
  <body>
    <header class="site">
      <div class="wrap">
        <a class="lockup" href="/">
          <img src="/assets/netc-primary-horizontal-colour.svg" alt="Never Ending Trail Club" />
        </a>
        <nav class="main">
          <a class="nl" href="/#trips">Trips</a>
          <a class="nl" href="/stories">Stories</a>
          <a class="nl" href="/about">About us</a>
          <a class="btn" href="/join">Join a trip</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site on-indigo">
      <div class="wrap">
        <div class="top">
          <div>
            <img
              class="flogo"
              src="/assets/netc-alternate-bilingual-reverse.svg"
              alt="Never Ending Trail Club · নেভার এন্ডিং ট্রেল ক্লাব"
            />
          </div>
          <div>
            <div class="label h">Club</div>
            <ul>
              <li><a href="/#trips">Trips</a></li>
              <li><a href="/stories">Stories</a></li>
              <li><a href="/about">About us</a></li>
              <li><a href="/join">Join a trip</a></li>
            </ul>
          </div>
          <div>
            <div class="label h">Follow</div>
            <ul>
              <li><a href="#">Instagram</a></li>
              <li><a href="#">YouTube</a></li>
              <li><a href="#">Facebook</a></li>
            </ul>
          </div>
        </div>
        <div class="bot">
          <span>Travel · Stories · Friends</span>
          <span class="label">Trip 12 and counting</span>
        </div>
      </div>
    </footer>
    <script is:inline src="/netc-motion.js"></script>

    <!-- NETC sun cursor trail -->
    <svg class="netc-trail" aria-hidden="true"><circle r="2.5"/><circle r="2.5"/></svg>

    <style>
      .netc-trail { position: fixed; inset: 0; width: 100%; height: 100%;
        pointer-events: none; z-index: 9998; overflow: visible; }
      .netc-trail path { fill: none; stroke: #C9372C;
        stroke-linecap: round; stroke-linejoin: round; opacity: 0; transition: opacity .25s; }
      .netc-trail circle { fill: #C9372C; opacity: 0; transition: opacity .25s; }
      body.netc-moving .netc-trail path { opacity: .35; }
      body.netc-moving .netc-trail circle { opacity: .6; }
    </style>

    <script is:inline>
      (() => {
        if (!matchMedia('(pointer: fine)').matches) return;
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        const svg = document.querySelector('.netc-trail');
        const dots = svg.querySelectorAll('circle');
        const segs = Array.from({ length: 8 }, () => svg.insertBefore(
          document.createElementNS('http://www.w3.org/2000/svg', 'path'), svg.firstChild));
        const hist = [];
        let tx = null, ty = null, fx = 0, fy = 0, idle;
        addEventListener('pointermove', e => {
          if (tx === null) { fx = e.clientX; fy = e.clientY; }
          tx = e.clientX; ty = e.clientY;
          document.body.classList.add('netc-moving');
          clearTimeout(idle);
          idle = setTimeout(() => document.body.classList.remove('netc-moving'), 450);
        });
        (function tick() {
          if (tx !== null) {
            fx += (tx - fx) * 0.3; fy += (ty - fy) * 0.3;
            hist.unshift({ x: fx, y: fy }); if (hist.length > 15) hist.pop();
            [2, 4].forEach((k, i) => { const p = hist[Math.min(k, hist.length - 1)];
              dots[i].setAttribute('cx', p.x); dots[i].setAttribute('cy', p.y); });
            segs.forEach((el, i) => {
              const a = hist[6 + i], b = hist[7 + i];
              el.setAttribute('d', a && b ? `M${a.x} ${a.y}L${b.x} ${b.y}` : '');
              el.style.strokeWidth = 2.6 - i * 0.3;
            });
          }
          requestAnimationFrame(tick);
        })();
      })();
    </script>
  </body>
</html>

<style>
  :root {
    --indigo: #23325e;
    --red: #c9372c;
    --red-on-indigo: #e0503f;
    --turmeric: #e3a21a;
    --turmeric-on-indigo: #edb22a;
    --cream: #f1e9d8;
    --paper: #fbf8f1;
    --ink: #16130f;
    --display: 'Archivo', 'Arial Black', sans-serif;
    --mono: 'IBM Plex Mono', 'Courier New', monospace;
    --bn: 'Anek Bangla', sans-serif;
    --sec: 96px;
    --sb-track: #fbf8f1;
    --sb-thumb: #c9372c;
  }

  ::-webkit-scrollbar {
    width: 12px;
    height: 12px;
  }

  ::-webkit-scrollbar-track {
    background: var(--sb-track);
  }

  ::-webkit-scrollbar-thumb {
    background: var(--sb-thumb);
    border: 3px solid var(--sb-track);
    border-radius: 0;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: var(--indigo);
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body, html {
    background: var(--paper);
    color: var(--ink);
    font: 400 18px/1.5 var(--display);
    font-stretch: 100%;
    -webkit-font-smoothing: antialiased;
  }

  /* NETC sun cursor - base64 encoded SVG */
  body {
    cursor: url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSIzMiIgaGVpZ2h0PSIzMiIgdmlld0JveD0iMCAwIDMyIDMyIj48Y2lyY2xlIGN4PSIxNiIgY3k9IjE2IiByPSI4IiBmaWxsPSIjRTNBMjFBIiBzdHJva2U9IiMyMzMyNUUiIHN0cm9rZS13aWR0aD0iMiIvPjwvc3ZnPg==') 16 16, auto;
  }

  a, button, [role="button"], label, summary {
    cursor: url('data:image/svg+xml;base64,') 16 16, pointer;
  }

  input, textarea, [contenteditable] {
    cursor: text;
  }

  /* Dark theme cursors */
  .on-indigo {
    cursor: url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSIzMiIgaGVpZ2h0PSIzMiIgdmlld0JveD0iMCAwIDMyIDMyIj48Y2lyY2xlIGN4PSIxNiIgY3k9IjE2IiByPSI4IiBmaWxsPSIjRURCMjJBIiBzdHJva2U9IiNGMUU5RDgiIHN0cm9rZS13aWR0aD0iMiIvPjwvc3ZnPg==') 16 16, auto;
  }

  .on-indigo a, .on-indigo button, .on-indigo [role="button"], .on-indigo label, .on-indigo summary {
    cursor: url('data:image/svg+xml;base64,') 16 16, pointer;
  }

  a {
    color: var(--red);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.15s;
  }

  a:hover {
    color: var(--indigo);
  }

  /* Ensure all links and buttons have sufficient color contrast */
  @media (prefers-contrast: more) {
    a {
      text-decoration-thickness: 2px;
    }
  }

  /* Reduce motion for users who prefer it */
  @media (prefers-reduced-motion: reduce) {
    * {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }

  :focus-visible {
    outline: 3px solid var(--indigo);
    outline-offset: 3px;
  }

  .on-indigo :focus-visible {
    outline-color: var(--turmeric-on-indigo);
  }

  .wrap {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .disp {
    font-family: var(--display);
    font-stretch: 125%;
    font-weight: 800;
    text-transform: uppercase;
    line-height: 1.02;
    letter-spacing: 0;
  }

  .label {
    font: 600 14px/1.2 var(--mono);
    text-transform: uppercase;
    letter-spacing: 3px;
  }

  .tag {
    display: inline-flex;
    font: 600 14px/1 var(--mono);
    letter-spacing: 3px;
    text-transform: uppercase;
    background: var(--turmeric);
    color: var(--indigo);
    padding: 8px 10px;
  }

  .on-indigo .tag.bare {
    background: none;
    color: var(--turmeric-on-indigo);
    padding: 0;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    font: 600 16px/1 var(--display);
    padding: 16px 24px;
    text-decoration: none;
    border: 2px solid var(--red);
    background: var(--red);
    color: var(--paper);
    transition: background 0.15s, border-color 0.15s, color 0.15s;
  }

  .btn:hover {
    background: var(--indigo);
    border-color: var(--indigo);
    color: var(--paper);
  }

  .btn.ghost {
    background: none;
    color: var(--indigo);
    border-color: var(--indigo);
  }

  .btn.ghost:hover {
    background: var(--indigo);
    color: var(--cream);
  }

  .on-indigo .btn.ghost {
    color: var(--cream);
    border-color: var(--cream);
  }

  .on-indigo .btn.ghost:hover {
    background: var(--cream);
    color: var(--indigo);
  }

  /* header */
  header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--paper);
    border-bottom: 2px solid var(--indigo);
  }

  header .wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: 88px;
  }

  .lockup {
    display: flex;
    align-items: center;
    gap: 14px;
    text-decoration: none;
    color: var(--indigo);
  }

  .lockup img {
    height: 48px;
    width: auto;
    display: block;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  nav a.nl {
    color: var(--indigo);
    text-decoration: none;
    font-weight: 600;
    font-size: 16px;
    border-bottom: 2px solid transparent;
    padding: 4px 0;
    transition: border-color 0.15s;
  }

  nav a.nl:hover {
    border-color: var(--red);
  }

  /* footer */
  footer {
    background: var(--indigo);
    color: var(--cream);
    padding: 72px 0 40px;
  }

  footer .top {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: 40px;
  }

  footer .flogo {
    display: block;
    width: 100%;
    max-width: 360px;
    height: auto;
  }

  footer ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 16px;
  }

  footer a {
    color: var(--cream);
  }

  footer a:hover {
    color: var(--turmeric-on-indigo);
  }

  footer .h {
    color: var(--turmeric-on-indigo);
  }

  footer .bot {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    margin-top: 64px;
    padding-top: 24px;
    border-top: 2px solid rgba(241, 233, 216, 0.25);
    font-size: 16px;
    flex-wrap: wrap;
  }

  @media (max-width: 768px) {
    :root {
      --sec: 56px;
    }

    body {
      font-size: 16px;
    }

    .wrap {
      padding: 0 20px;
    }

    header .wrap {
      height: 72px;
    }

    .lockup img {
      height: 40px;
    }

    nav {
      gap: 16px;
    }

    nav a.nl {
      display: none;
    }

    .btn {
      padding: 14px 18px;
      font-size: 15px;
    }

    .label,
    .tag {
      font-size: 12px;
    }

    footer .top {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
