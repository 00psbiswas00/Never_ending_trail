---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About us">
  <section class="ahero on-indigo" data-screen-label="About hero">
    <div class="wrap">
      <div>
        <div class="label">01 / Who we are</div>
        <h1 class="disp">Every trip is a frame.</h1>
        <div class="bn" lang="bn">নেভার এন্ডিং ট্রেল ক্লাব</div>
        <p>A group of friends who travel anywhere, by any means: bike, train, road, boat, plane, mountains. Every trip becomes a story on our social pages, YouTube, blog and vlogs.</p>
      </div>
      <div><div class="frame"><span class="slot">The whole group, on a trip</span></div><div class="cap">[Caption: where this was, and which trip.]</div></div>
    </div>
  </section>
  <section class="idea" data-screen-label="The idea">
    <div class="wrap">
      <h2 class="h2dot">Frame, sun, route</h2>
      <p class="intro">Pattachitra, Bengal's scroll painting, is how we tell it. A Patua painter tells a story panel by panel along one long scroll. Each of our trips is one panel.</p>
      <div class="igrid">
        <div class="icard"><div class="ic"><svg width="55" height="55" viewBox="16 16 168 168" aria-hidden="true"><path d="M176 80V24H24V176H176V136" fill="none" stroke="#23325E" stroke-width="16"></path></svg></div><div class="label" style="color:var(--indigo)">The frame</div><h3>One trip, one story</h3><p>One panel of a Patua scroll. Every photo we post sits inside it.</p></div>
        <div class="icard"><div class="ic"><svg width="48" height="48" viewBox="116 46 36 36" aria-hidden="true"><circle cx="134" cy="64" r="18" fill="#E3A21A"></circle></svg></div><div class="label" style="color:var(--indigo)">The sun</div><h3>The early start</h3><p>The adventure, and the next place we haven't been yet.</p></div>
        <div class="icard"><div class="ic"><svg width="51" height="19" viewBox="40 100 154 58" aria-hidden="true"><path d="M48 150C80 150 96 108 130 108H140" fill="none" stroke="#C9372C" stroke-width="16" stroke-linecap="round"></path><circle cx="164" cy="108" r="8" fill="#C9372C"></circle><circle cx="186" cy="108" r="8" fill="#C9372C"></circle></svg></div><div class="label" style="color:var(--indigo)">The route</div><h3>However we got there</h3><p>It walks out of the frame and keeps going: never ending.</p></div>
      </div>
    </div>
  </section>
  <section class="crew" data-screen-label="Members">
    <div class="wrap">
      <div class="top"><div><h2 class="h2dot">The crew</h2><p>The friends behind every trip. Different jobs on the road, one story at the end.</p></div><span class="label" style="color:var(--indigo)">Trip 12 and counting</span></div>
      <div class="mgrid" id="mgrid"></div>
    </div>
  </section>
  <section class="join" data-screen-label="Join">
    <div class="wrap">
      <div><h2 class="disp">Come on the next one.</h2><p>Trip 13 is being planned. Tell us you're in and we'll send the details.</p></div>
      <a class="btn" href="/join">Join a trip</a>
    </div>
  </section>
</Layout>

<style>
  .h2dot{display:flex;align-items:center;gap:16px;font:600 36px/1.2 var(--display);color:var(--indigo)}
  .h2dot::before{content:"";width:20px;height:20px;border-radius:50%;background:var(--turmeric);flex:none}
  .ahero{background:var(--indigo);color:var(--cream);padding:var(--sec) 0}
  .ahero .wrap{display:grid;grid-template-columns:minmax(0,6fr) minmax(0,5fr);gap:64px;align-items:center}
  .ahero .label{color:var(--turmeric-on-indigo)}
  .ahero h1{font-size:84px;margin:20px 0 8px}
  .ahero .bn{font:700 36px/1.2 var(--bn);color:var(--cream)}
  .ahero p{margin-top:28px;max-width:32em}
  .ahero .frame{border-color:var(--cream);aspect-ratio:4/3}
  .ahero .cap{margin-top:12px;font-size:16px}
  .idea{padding:var(--sec) 0}
  .idea .intro{max-width:40em;margin:24px 0 56px}
  .igrid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}
  .icard{border:4px solid var(--indigo);padding:32px;display:flex;flex-direction:column;gap:16px}
  .icard .ic{height:56px;display:flex;align-items:center}
  .icard h3{font:600 24px/1.25 var(--display);color:var(--indigo)}
  .icard p{font-size:16px}
  .crew{background:var(--cream);border-top:2px solid var(--indigo);border-bottom:2px solid var(--indigo);padding:var(--sec) 0}
  .crew .top{display:flex;justify-content:space-between;align-items:end;gap:24px;margin-bottom:48px;flex-wrap:wrap}
  .crew .top p{max-width:30em;margin-top:16px}
  .mgrid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:40px 24px}
  .mgrid :global(.member){display:flex;flex-direction:column;gap:12px}
  .mgrid :global(.member .frame){aspect-ratio:4/5;border-width:6px;background:var(--paper);transition:border-color .18s}
  .mgrid :global(.member:hover .frame){border-color:var(--red)}
  .mgrid :global(.member h3){font:600 24px/1.2 var(--display);color:var(--indigo);transition:color .18s}
  .mgrid :global(.member:hover h3){color:var(--red)}
  .mgrid :global(.member .bn){font:500 20px/1.2 var(--bn);color:var(--indigo);margin-top:-6px}
  .mgrid :global(.member p){font-size:16px}
  .mgrid :global(.member .since){color:var(--indigo)}
  .mgrid :global(.member .tag){margin-top:4px}
  .join{padding:var(--sec) 0}
  .join .wrap{display:flex;justify-content:space-between;align-items:center;gap:40px;flex-wrap:wrap}
  .join h2{font-size:56px;color:var(--indigo)}
  .join p{margin-top:16px;max-width:32em}
  @media (max-width:1100px){.mgrid{grid-template-columns:repeat(3,minmax(0,1fr))}.ahero h1{font-size:60px}}
  @media (max-width:768px){.ahero .wrap{grid-template-columns:minmax(0,1fr);gap:40px}.ahero h1{font-size:40px}.ahero .bn{font-size:26px}.h2dot{font-size:26px}.igrid{grid-template-columns:minmax(0,1fr)}.icard{padding:24px}.icard h3,.mgrid :global(.member h3){font-size:20px}.mgrid{grid-template-columns:repeat(2,minmax(0,1fr));gap:32px 16px}.mgrid :global(.member .bn){font-size:18px}.join h2{font-size:32px}}
</style>

<script>
  const crew=Array.from({length:8},(_,i)=>i+1);
  document.getElementById('mgrid').innerHTML=crew.map(i=>`<div class="member"><div class="frame"><span class="slot">Member photo, on a trip</span></div><h3>[Name]</h3><div class="bn" lang="bn">[নাম]</div><p>[Their job on the road: the map reader, the one with the camera, the tea finder.]</p><div class="label since">Since Trip [01] · [Home town]</div></div>`).join('');
</script>
