---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home">
  <section class="hero on-indigo" data-screen-label="Hero">
    <div class="wrap">
      <div>
        <span class="tag">Trip 12 · Bengal</span>
        <h1 class="disp">Every trip is a frame.</h1>
        <p>
          We are a group of Bengali friends who travel anywhere, by any means. Every trip becomes one panel of a scroll that keeps going.<span class="bn" lang="bn">প্রতিটি যাত্রা একটি ফ্রেম।</span>
        </p>
        <div class="ctas"><a class="btn" href="/story">Read the story</a></div>
      </div>
      <div class="hero-art">
        <div class="sun" aria-hidden="true"></div>
        <div class="frame"><image-slot id="hero-trip12" shape="rect" placeholder="Group photo from Trip 12"></image-slot></div>
        <div class="cap label"><span>Trip 12 · Bengal</span><span>September 2026</span></div>
      </div>
    </div>
  </section>

  <section class="about" data-screen-label="Who we are">
    <div class="wrap">
      <div class="label" style="color:var(--indigo)">01 / Who we are</div>
      <div>
        <h2>A travel club, not a company. We go together, we get lost together, and we tell it the way it happened.</h2>
        <div class="modes label"><span>Bike</span><span>Train</span><span>Road</span><span>Boat</span><span>Plane</span><span>Mountains</span></div>
      </div>
    </div>
  </section>

  <div class="wrap" aria-hidden="true" style="padding-top:56px"><svg class="flow" aria-hidden="true"></svg></div>

  <section class="trips" id="trips" data-screen-label="Trips">
    <div class="wrap">
      <div class="sec-head"><h2 class="h2dot">Latest trips</h2><a href="#">All trips</a></div>
      <div class="stops" aria-hidden="true"><span class="now"></span><span></span><span></span></div>
      <div class="tgrid" id="tripGrid"></div>
    </div>
  </section>

  <section class="tell" data-screen-label="Where we tell it">
    <div class="wrap">
      <h2 class="h2dot">Where we tell it</h2>
      <div class="cgrid">
        <div class="chan">
          <div class="ph"><image-slot id="chan-youtube" shape="rect" placeholder="Latest video thumbnail"></image-slot></div>
          <div class="ic">
            <svg width="48" height="48" viewBox="116 46 36 36" aria-hidden="true"><circle cx="134" cy="64" r="18" fill="#E3A21A"></circle></svg>
          </div>
          <div class="label lbl">YouTube</div>
          <h3>The vlogs</h3>
          <p>The whole trip, wrong turns included. Watch us get lost and find the tea stall.</p>
          <a href="https://youtube.com" aria-label="Watch our vlogs on YouTube">Subscribe on YouTube</a>
        </div>
        <div class="chan">
          <div class="ph"><image-slot id="chan-instagram" shape="rect" placeholder="Latest Instagram post"></image-slot></div>
          <div class="ic">
            <svg width="55" height="55" viewBox="16 16 168 168" aria-hidden="true"><path d="M176 80V24H24V176H176V136" fill="none" stroke="#23325E" stroke-width="16"></path></svg>
          </div>
          <div class="label lbl">Instagram</div>
          <h3>The scroll</h3>
          <p>Every photo in its frame. Scroll the grid and it reads like one long painting.</p>
          <a href="https://instagram.com" aria-label="Follow our photos on Instagram">Follow on Instagram</a>
        </div>
        <div class="chan">
          <div class="ph"><image-slot id="chan-blog" shape="rect" placeholder="Latest story cover"></image-slot></div>
          <div class="ic">
            <svg width="51" height="19" viewBox="40 100 154 58" aria-hidden="true"><path d="M48 150C80 150 96 108 130 108H140" fill="none" stroke="#C9372C" stroke-width="16" stroke-linecap="round"></path><circle cx="164" cy="108" r="8" fill="#C9372C"></circle><circle cx="186" cy="108" r="8" fill="#C9372C"></circle></svg>
          </div>
          <div class="label lbl">Blog</div>
          <h3>The long version</h3>
          <p>Written up after we're home. The places, the people, and the tips worth passing on.</p>
          <a href="/stories">Read the blog</a>
        </div>
      </div>
    </div>
  </section>

  <section class="scroll" id="stories" data-screen-label="The scroll">
    <div class="wrap">
      <div>
        <span class="tag">Pattachitra</span>
        <h2 class="disp">One panel of an endless scroll.</h2>
        <p>A Patua painter tells a story panel by panel along a long scroll of cloth. We tell ours the same way. One trip, one frame, and the route always walks out the side toward the next one.</p>
        <p>Every story opens with its trip number, so every post, reel and video joins the same scroll.</p>
        <p style="margin-top:24px"><a href="/stories">Read the stories</a></p>
      </div>
      <div class="panels">
        <div><image-slot id="panel-a" shape="rect" placeholder="Trip photo"></image-slot><span class="tag n">Trip 10</span></div>
        <div><image-slot id="panel-b" shape="rect" placeholder="Trip photo"></image-slot><span class="tag n">Trip 11</span></div>
        <div><image-slot id="panel-c" shape="rect" placeholder="Trip photo"></image-slot><span class="tag n">Trip 12</span></div>
      </div>
    </div>
  </section>

  <section class="join" id="join" data-screen-label="Join">
    <div class="wrap">
      <div><h2 class="disp">Come on the next one.</h2><p>Trip 13 is being planned. Tell us you're in and we'll send the details.</p></div>
      <a class="btn" href="#">Join a trip</a>
    </div>
  </section>
</Layout>

<script>
  const trips = [
    { num: 11, place: 'Darjeeling', title: 'Tea gardens and mountain mist', desc: 'Lost in cloud forests, found in village tea houses.' },
    { num: 10, place: 'Sundarbans', title: 'Among the mangroves', desc: 'Where land meets water and tigers roam unseen.' },
    { num: 9, place: 'Rajasthan', title: 'Desert roads and dunes', desc: 'Dust storms, singing dunes, and stars that filled the sky.' }
  ];
  document.getElementById('tripGrid').innerHTML = trips
    .map((trip) => {
      const nn = String(trip.num).padStart(2, '0');
      return `<article class="tcard" id="trip-${nn}"><div class="ph"><image-slot id="trip-${nn}-photo" shape="rect" placeholder="Trip ${nn} photo"></image-slot></div><div class="bd"><span class="tag">Trip ${nn} · ${trip.place}</span><h3>${trip.title}</h3><p>${trip.desc}</p><a href="/story">Read the story</a></div></article>`;
    })
    .join('');
</script>
