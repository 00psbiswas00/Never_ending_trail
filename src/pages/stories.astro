---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Stories">
  <section class="intro" data-screen-label="Stories intro">
    <div class="wrap">
      <h1 class="disp">Stories</h1>
      <div class="bn" lang="bn">গল্প</div>
      <p>Every trip we take, told by the friends who were there. Newest first, one panel of the scroll at a time.</p>
      <div class="filters" role="group" aria-label="Filter by how we travelled" id="filters"></div>
    </div>
  </section>
  <section data-screen-label="Featured story">
    <div class="wrap">
      <a class="feature" href="/story">
        <div class="frame"><image-slot id="story-12-hero" shape="rect" placeholder="Trip 12 hero photo"></image-slot></div>
        <div class="txt">
          <span class="tag">Trip 12 · [Place]</span>
          <h2 class="disp">[Trip story headline]</h2>
          <p>[One or two sentences that open the story. Place first, then the moment.]</p>
          <div class="label" style="color:var(--indigo)">[Date] · Train · 8 min read</div>
          <span class="more">Read the story</span>
        </div>
      </a>
      <div class="divider" aria-hidden="true"><svg class="flow" aria-hidden="true"></svg></div>
    </div>
  </section>
  <section class="list" data-screen-label="All stories">
    <div class="wrap">
      <div class="grid" id="grid"></div>
      <div class="empty label" id="empty">No stories for this one yet.</div>
      <div class="pager"><a class="btn ghost" href="#">Older stories</a></div>
    </div>
  </section>
</Layout>

<style>
  .intro{padding:var(--sec) 0 56px}
  .intro h1{font-size:56px;color:var(--indigo)}
  .intro .bn{font:700 36px/1.2 var(--bn);color:var(--indigo);margin-top:8px}
  .intro p{max-width:34em;margin-top:24px}
  .filters{display:flex;flex-wrap:wrap;gap:8px;margin-top:40px}
  .filters :global(button){font:600 14px/1 var(--mono);letter-spacing:3px;text-transform:uppercase;min-height:44px;padding:12px 14px;border:2px solid var(--indigo);background:none;color:var(--indigo);cursor:pointer;transition:background .15s,color .15s}
  .filters :global(button:hover){background:var(--cream)}
  .filters :global(button[aria-pressed="true"]){background:var(--indigo);color:var(--cream)}
  .feature{display:grid;grid-template-columns:minmax(0,7fr) minmax(0,5fr);gap:48px;align-items:center;text-decoration:none;color:var(--ink);}
  .feature .frame{aspect-ratio:3/2;transition:border-color .15s}
  .feature:hover .frame{border-color:var(--red)}
  .feature .txt{display:flex;flex-direction:column;gap:20px}
  .feature h2{font-size:40px;color:var(--indigo);text-wrap:balance}
  .feature .more{color:var(--red);text-decoration:underline;text-underline-offset:3px;font-weight:600}
  .list{padding:56px 0 var(--sec)}
  .divider{padding-top:56px}
  .grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:56px 32px}
  .card{display:flex;flex-direction:column;gap:16px;text-decoration:none;color:var(--ink)}
  .card .frame{aspect-ratio:4/3;border-width:6px;transition:border-color .15s}
  .card:hover .frame{border-color:var(--red)}
  .card h3{font:600 24px/1.25 var(--display);color:var(--indigo)}
  .card p{font-size:16px}
  .card .meta{color:var(--indigo)}
  .card[hidden]{display:none}
  .empty{display:none;padding:40px 0;color:var(--indigo)}
  .pager{display:flex;justify-content:center;margin-top:72px}
  @media (max-width:768px){.intro h1{font-size:32px}.intro .bn{font-size:26px}.feature{grid-template-columns:minmax(0,1fr);gap:24px}.feature h2{font-size:26px}.grid{grid-template-columns:minmax(0,1fr)}.card h3{font-size:20px}}
  @media (min-width:769px) and (max-width:1100px){.grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
</style>

<script>
  const modes=['All','Bike','Train','Road','Boat','Plane','Mountains'];
  const stories=[[11,'Road'],[10,'Boat'],[9,'Mountains'],[8,'Bike'],[7,'Train'],[6,'Plane']];
  document.getElementById('grid').innerHTML=stories.map(([n,m])=>{const nn=String(n).padStart(2,'0');return `<a class="card" href="/story" data-mode="${m}"><div class="frame"><image-slot id="story-${nn}-photo" shape="rect" placeholder="Trip ${nn} photo"></image-slot></div><span class="tag">Trip ${nn} · [Place]</span><h3>[Trip story headline]</h3><p>[Opening line of the story.]</p><div class="label meta">[Date] · ${m}</div></a>`}).join('');
  const f=document.getElementById('filters');
  f.innerHTML=modes.map((m,i)=>`<button type="button" aria-pressed="${i===0}" data-m="${m}">${m}</button>`).join('');
  f.addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;f.querySelectorAll('button').forEach(x=>x.setAttribute('aria-pressed',x===b));let shown=0;document.querySelectorAll('.card').forEach(c=>{const ok=b.dataset.m==='All'||c.dataset.mode===b.dataset.m;c.hidden=!ok;if(ok)shown++});document.getElementById('empty').style.display=shown?'none':'block'});
</script>
